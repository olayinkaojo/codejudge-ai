# Local development only. Use a secret manager and managed PostgreSQL in production.
DATABASE_URL=postgresql+psycopg://codejudge:codejudge@localhost:55432/codejudge
POSTGRES_PASSWORD=codejudge
POSTGRES_PORT=55432
API_PORT=8000
# Operator-controlled HTTPS evaluation endpoint. No built-in code execution.
# SANDBOX_URL=https://sandbox.example/v1/evaluate
# SANDBOX_TOKEN=replace-through-secret-manager
TOKEN_HOURS=24
MAX_ATTEMPTS=3
LEASE_SECONDS=180
SANDBOX_TIMEOUT=30
ALLOW_INSECURE_SANDBOX=false

# Text-only code reviews. Defaults make no external AI requests.
REVIEW_PROVIDER=mock
REVIEW_EXTERNAL_ENABLED=false
REVIEW_TIMEOUT=5
REVIEW_MAX_OUTPUT_TOKENS=1200
REVIEW_USER_DAILY_LIMIT=20
REVIEW_GLOBAL_DAILY_LIMIT=200
# Future opt-in only; never put a real key in this file or frontend env vars.
# REVIEW_API_KEY=
# REVIEW_MODEL=gpt-4.1-mini
