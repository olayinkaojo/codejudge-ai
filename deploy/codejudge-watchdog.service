[Unit]
Description=CodeJudge independent gVisor sandbox deadline reaper
After=docker.service
Requires=docker.service

[Service]
User=codejudge-runner
Group=docker
WorkingDirectory=/opt/codejudge
EnvironmentFile=/etc/codejudge-runner.env
StateDirectory=codejudge-runner
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
ExecStart=/opt/codejudge/.venv/bin/python -m runner.watchdog
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/codejudge-runner

[Install]
WantedBy=multi-user.target
